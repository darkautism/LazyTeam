FROM ubuntu:24.04 AS agent-base
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash build-essential ca-certificates coreutils curl diffutils file findutils gawk git grep gzip jq patch pkg-config procps python3 ripgrep sed tar unzip \
    && rm -rf /var/lib/apt/lists/* \
    && tar --numeric-owner --one-file-system \
        --exclude=./proc --exclude=./sys --exclude=./dev --exclude=./run --exclude=./tmp \
        -C / -czf /tmp/lazyteam-ubuntu-rootfs.tar.gz . \
    && sha256sum /tmp/lazyteam-ubuntu-rootfs.tar.gz | awk '{print $1}' > /tmp/lazyteam-ubuntu-rootfs.tar.gz.sha256

FROM rust:1-bookworm AS builder
ARG LAZYTEAM_GIT_SHA
ENV LAZYTEAM_GIT_SHA=${LAZYTEAM_GIT_SHA}
WORKDIR /src
COPY . .
RUN cargo build --release -p lazyteam-worker

FROM node:22-bookworm-slim
ARG PI_CODING_AGENT_VERSION=0.87.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash build-essential ca-certificates coreutils curl findutils git gosu grep gzip openssh-client pkg-config procps sed tar util-linux \
    && npm install --global "@earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/state/home /app/workspaces \
    && chmod 0777 /app/state /app/state/home /app/workspaces
COPY --from=builder /src/target/release/lazyteam-worker /usr/local/bin/lazyteam-worker
COPY --from=agent-base /tmp/lazyteam-ubuntu-rootfs.tar.gz /opt/lazyteam/ubuntu-rootfs.tar.gz
COPY --from=agent-base /tmp/lazyteam-ubuntu-rootfs.tar.gz.sha256 /opt/lazyteam/ubuntu-rootfs.tar.gz.sha256
COPY deploy/docker-entrypoint.sh /usr/local/bin/lazyteam-entrypoint
COPY deploy/pi-auto-update.sh /usr/local/bin/lazyteam-pi-update
RUN chmod 0755 /usr/local/bin/lazyteam-entrypoint /usr/local/bin/lazyteam-pi-update
WORKDIR /app
ENV HOME=/app/state/home
ENV LAZYTEAM_DATA_DIR=/app/state
ENV LAZYTEAM_HOME=/app/state/home
ENV LAZYTEAM_WORKER_STATE_DIR=/app/state
ENV LAZYTEAM_WORKSPACE_DIR=/app/workspaces
ENV LAZYTEAM_PI_BIN=pi
ENV LAZYTEAM_PI_AUTO_UPDATE=1
ENV LAZYTEAM_PI_UPDATE_INTERVAL_SECS=86400
ENV LAZYTEAM_UBUNTU_BASE_ARCHIVE=/opt/lazyteam/ubuntu-rootfs.tar.gz
ENV LAZYTEAM_UBUNTU_BASE_ID=ubuntu-24.04-oci
ENV RUST_LOG=lazyteam_worker=info
VOLUME ["/app/state", "/app/workspaces"]
ENTRYPOINT ["lazyteam-entrypoint"]
CMD ["lazyteam-worker", "--project", "*", "--slots", "1"]
